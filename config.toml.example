# gomesh-broker configuration

# MQTT-over-WSS listener address
listen = "0.0.0.0:8083"

# TLS certificate and private key (PEM format)
# Generate a self-signed pair with: cargo run -- generate-cert
tls_cert = "cert.pem"
tls_key = "key.pem"

# Allowed IATA region codes (empty = allow all)
# allowed_regions = ["SFO", "LAX", "JFK"]

# Static subscriber accounts
# Each subscriber has an Argon2id password hash and a role ("full" or "limited").
# Generate a hash with: echo -n 'password' | argon2 salt -id -e
#
# [subscribers.example_user]
# password_hash = "$argon2id$v=19$m=65536,t=3,p=4$..."
# role = "full"
