# gomesh-broker configuration

# MQTT-over-WSS listener address
listen = "0.0.0.0:8083"

# TLS certificate and private key (PEM format). Set both to serve WSS; omit
# both to serve plain WS, e.g. behind a TLS-terminating proxy like HAProxy.
# Generate a self-signed pair with: cargo run -- generate-cert
tls_cert = "cert.pem"
tls_key = "key.pem"

# Read the client address from a PROXY protocol header on each connection.
# Only enable when the listener is reachable solely through a trusted proxy.
# proxy_protocol = false

# Allowed IATA region codes (empty = allow all)
# allowed_regions = ["SFO", "LAX", "JFK"]

# Access logging (optional — omit section to disable)
# Logs auth, publish, and subscribe events to a rotating JSON file.
# [access_log]
# path = "access.log"
# max_size = 10485760   # 10 MiB per file
# max_files = 5         # number of rotated files to keep

# Static subscriber accounts
# Each subscriber has an Argon2id password hash and a role ("full" or "limited").
# Generate a hash with: echo -n 'password' | argon2 "$(head -c16 /dev/random)" -id -e
#
# [subscribers.example_user]
# password_hash = "$argon2id$v=19$m=65536,t=3,p=4$..."
# role = "full"
